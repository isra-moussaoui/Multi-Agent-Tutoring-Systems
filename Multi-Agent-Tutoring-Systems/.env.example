# Copy to .env and fill in real keys. Never commit .env.

# One or more Groq keys (rotation on rate/daily limits)
GROQ_API_KEY=your_first_groq_key
GROQ_API_KEYS=your_second_groq_key,your_third_groq_key
# Optional numbered form:
# GROQ_API_KEY_2=...
# GROQ_API_KEY_3=...

# Optional Gemini keys (only if using --*-provider gemini)
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
