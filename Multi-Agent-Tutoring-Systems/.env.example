# Required for run_pipeline.py and run_baseline.py (default provider: Mistral)
# Get a key at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_key_here

# Optional — Groq (if you switch --*-provider groq)
# GROQ_API_KEY=your_groq_key_here

# Optional — Gemini (if you switch --*-provider gemini)
# GOOGLE_API_KEY=your_google_key_here

# Optional — only for Neo4j KG scripts (e.g. write_cleaned_responses.py), not needed for pipeline/baseline
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# Copy to .env and fill in real keys. Never commit .env.

# One or more Groq keys (rotation on rate/daily limits)
GROQ_API_KEY=your_first_groq_key
GROQ_API_KEYS=your_second_groq_key,your_third_groq_key
# Optional numbered form:
# GROQ_API_KEY_2=...
# GROQ_API_KEY_3=...

# Optional Gemini keys (only if using --*-provider gemini)
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
